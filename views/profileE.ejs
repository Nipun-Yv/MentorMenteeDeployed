<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Profile Page</title>
    <link rel="stylesheet" href="./styles/profileE.css">
</head>
<body>

    <div class="profile-container">
        <a href="/home">Go Back</a>
        <div class="profile-image">
            <img alt="Profile Image" class="circle-img" src='<%=src?src:"/images/default.png"%>'>
        </div>
        <div class="profile-details">
            <form id="profileForm" action="/profile" method="POST">
                <label for="name">Name:</label>
                <input type="text" id="name" name="name" value=<%=fullname%> disabled>

                <label for="email">Email:</label>
                <input type="email" id="email" name="email" disabled value=<%=username%> >

                <label for="organisation">Organisation:</label>
                <input type="text" id="organisation" name="organisation" disabled value=<%=organisation%> >

                <label for="description">Description:</label>
                <textarea id="description" name="description" rows="3" disabled><%=description?description:null%></textarea>

                <label for="linkedin">LinkedIn Profile:</label>
                <input type="url" id="linkedin" name="linkedin" disabled value=<%=linkedin%>>

                <button type="button" id="editButton">Edit</button>
                <button type="submit" id="submitButton" style="display: none;">Submit</button>
            </form>
        </div>
    </div>

    <script src="/scripts/profileE.js"></script>

</body>
</html>

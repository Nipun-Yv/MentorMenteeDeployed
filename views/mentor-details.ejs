<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Mentor Details</title>
    <link rel="stylesheet" href="https://stackpath.bootstrapcdn.com/bootstrap/4.5.2/css/bootstrap.min.css">
    <!-- <link rel="stylesheet" href="/styles.css"> -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">
    <style>
        .card-body button{
            width:90%;
            margin-left:5%;
            height:40px;
            background-color: green;
            color:white;
            margin-top:10%;
            border-radius:8px;
        }
        textarea{
            margin-left:5%;
            width:90%;
            margin-bottom:-10%;
            height:10vw;
        }
    </style>
</head>
<body>
    <div class="container mt-5">
       
        <div class="card detail-card shadow-lg">
            <div class="row no-gutters">
                <div class="col-md-4 d-flex align-items-center">
                    <img src= '<%=mentor.src%>' class="card-img img-fluid rounded" alt="<%= mentor.name %>">
                </div>
                <div class="col-md-8">
                    <div class="card-body">
                        <h3 class="card-title"><%= mentor.fullname %></h3>
                        <p class="card-text"><%= mentor.card%></p>
                        <hr>
                        <p class="card-text">
                            <strong>Organisation:</strong> <%= mentor.organisation %>
                        </p>
                        <p class="card-text">
                            <strong>Credentials</strong> <%= mentor.credentials%>
                        </p>
                        <p class="card-text">
                            <strong>Price-cap:</strong> ₹<%=mentor.price %>
                        </p>
                        <form action="/book" method="POST">
                        <input type="text" hidden name="mid" value='<%=mentor.mid%>'>
                        <input type="text" hidden name="price" value='<%=mentor.price%>'>
                        <textarea name="description" placeholder="Add your query description"></textarea>
                        <button type="submit">Proceed To Book Session</button>
                    </form>
                    </div>
                </div>
            </div>
        </div>
     
        <div class="text-center mt-4">
            <a href="<%= mentor.linkedin %>" class="btn btn-linkedin btn-lg mx-2" target="_blank">
                <i class="fab fa-linkedin"></i> LinkedIn
            </a>
            <button class="btn btn-follow btn-lg mx-2">
                <i class="fas fa-user-plus"></i> Follow
            </button>
            <button class="btn btn-contact btn-lg mx-2">
                <i class="fas fa-envelope"></i> Contact
            </button>
            <button class="btn btn-plans btn-lg mx-2">
                <i class="fas fa-file-invoice-dollar"></i> See Plans
            </button>
        </div>
    </div>

    <script src="https://code.jquery.com/jquery-3.5.1.slim.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/@popperjs/core@2.5.2/dist/umd/popper.min.js"></script>
    <script src="https://stackpath.bootstrapcdn.com/bootstrap/4.5.2/js/bootstrap.min.js"></script>
</body>
</html>

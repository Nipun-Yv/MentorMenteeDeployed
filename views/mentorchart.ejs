function postModule(event){
    var x=document.querySelector("body>form");
    console.log(x)
    x.querySelectorAll("input")[0].value=document.querySelector(".specialf input").value
    x.querySelectorAll("input")[1].value=event.currentTarget.parentElement.parentElement.querySelector(".number>p").innerHTML.slice(7,100)

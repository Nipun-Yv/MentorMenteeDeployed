    <div class="module-container">
        <%for(var i=0;i<modules.length;i++){%>
            <div class="module">
                <div class="number">
                    <p>Module <%=modules[i].mno%></p>
                    <p class="heading"><%=modules[i].heading%></p>
                    <textarea hidden></textarea>
                </div>
                <div class="completion-time">
                    <p><%=modules[i].duration%></p>
                    <textarea hidden></textarea>
                </div>
                <div class="description">
                    <p><%=modules[i].description%></p>
                    <textarea hidden></textarea>
                </div>
                <div class="hyperlinks">Hyperlinks</div>
                <div class="link-list" hidden><textarea>Hello there</textarea></div>
                <div class="commit">
                    <button >BACK</button>
                    <button  onclick="postModule(event)"  >COMMIT</button>
                </div>
            </div>
            <%}%>


<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Find Your Mentor</title>
    <link rel="stylesheet" href="https://stackpath.bootstrapcdn.com/bootstrap/4.5.2/css/bootstrap.min.css">
    <link rel="stylesheet" href="/styles/menteehome.css">
</head>
<body>
    <h1 class="text-center">Advance<text>ment</text></h1>
    <nav class="navbar">
        <div class="container">
            <div class="logo">Find Your Mentor</div>
            <ul class="nav-links">
                <li><a href="/profile">Profile</a></li>
                <li><a href="/my-requests">Your Requests</a></li>
            </ul>
        </div>
    </nav>
    <div class="container mt-5">

<!--      
        <div class="mb-4">
            <label for="category">Select Category:</label>
            <select id="category" class="form-control" onchange="filterMentors()">
                <option value="all">All</option>
                <option value="Software">Software</option>
                <option value="Management">Management</option>

        <div class="row" id="mentorCards">
            <% mentors.forEach(mentor => { %>
                <div class="col-md-6 mb-3 mentor-card">
                    <div class="card h-100 d-flex flex-row align-items-center">
                        <div class="card-body d-flex flex-column justify-content-center">
                            <h5 class="card-title text-center"><%= mentor.fullname %></h5>
                            <p class="card-text"><strong>Price-cap:</strong>₹<%= mentor.price %></p>
                            <p class="card-text"><strong>Organization:</strong> <%= mentor.organisation %></p>
                            <p class="card-text"><strong>Categories:</strong> <%= mentor.card %></p>
                        </div>
                        <div class="image-container">
                            <img src="<%= mentor.src %>" alt="<%= mentor.fullname %>" class="rounded-circle img-fluid">
                        </div>
                        <form action="/mentor-details" method="POST" hidden><input name= "mentor" type="text" value='<%=mentor.mid%>'></form>
                    </div>
                </div>
            <% }); %>
        </div>
    </div>
    <script type="text/javascript">
        document.querySelectorAll(".card").forEach((element)=>{
            element.addEventListener("click",function(event){
                event.currentTarget.querySelector("form").submit();
            })
        })
